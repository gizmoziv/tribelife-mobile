      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b-sdk-55"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b-sdk-55"
      }
    }
  },
  "submit": {
    "production": {}
  }
