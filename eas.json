{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.14.0",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57"
      }
    },
    "production": {
      "node": "22.14.0",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57"
      }
    },
    "ios-scenes-test": {
      "extends": "preview",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "TRIBELIFE_IOS_SCENES": "1"
      },
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "ios-scenes-dev": {
      "extends": "development",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "TRIBELIFE_IOS_SCENES": "1"
      },
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
