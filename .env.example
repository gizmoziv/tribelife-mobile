# Backend API URL (your DigitalOcean droplet URL)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# RevenueCat API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxx

# Upload fetch opt-out (not a secret). Expo SDK 56+ makes expo/fetch the global fetch, which replaces
# the explicit Content-Type on Blob bodies (services/upload.ts, services/voiceUpload.ts) with blob.type,
# so voice-confirm returns 415 "File must be an audio type" and doc-confirm returns 415 (PDF).
# EXPO_PUBLIC_USE_RN_FETCH=1 keeps React Native's fetch so the app's explicit Content-Type is sent.
# Inlined at bundle time: restart Metro with `npx expo start --clear` after changing it.
# Required in BOTH the EAS preview and production environments (the 1.9.0 store build reads production).
# Remove once uploads migrate off fetch(file://) (before SDK 58).
EXPO_PUBLIC_USE_RN_FETCH=1

# iOS scene-lifecycle gate (not a secret; build-time only, read by app.config.js).
# TRIBELIFE_IOS_SCENES=1 turns on expo-build-properties ios.enableSceneSupport (iOS 27 / Xcode 27 UIScene lifecycle).
# Set ONLY in the env of the ios-scenes-test and ios-scenes-dev profiles in eas.json; never in this file, never in an EAS environment,
# never on development, preview or production (app.config.js refuses it on other EAS profiles; values other than 1 fail).
# Wrongly set on a store build: the binary runs the untested scene lifecycle. Missing on an Xcode 27 build: the app aborts at launch on iOS 27.
# TRIBELIFE_IOS_SCENES=1
